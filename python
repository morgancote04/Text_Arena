print("Text Arena")
print("Welcome to Text Arena! Try to defeat as many enemies within the dungeon as you can!")
score = 0
import random
import time
time.sleep(5)
print("Defeating an enemy gives you 1 point, escaping allows you to rest, but cost you 1 point.")
time.sleep(5)
print("You start with 3 potions, you have chances to find more when defeating an enemy. Good luck!")
time.sleep(5)
player = {"hp": 100, "max_hp" : 100, "attack_min" : 10, "attack_max" : 20, "heavy_min": 20, "heavy_max": 35, "potions": 3}
enemies = {
    "Goblin Raider": {"hp": 80, "attack_min":8, "attack_max": 15, "max_hp":80},
    "Skeleton Knight": {"hp":100, "attack_min":10, "attack_max": 18, "max_hp":100},
    "Giant Rat": {"hp":60, "attack_min":5, "attack_max":12, "max_hp":60},
    "Dark Wolf": {"hp":80, "attack_min":12, "attack_max":20, "max_hp":80}
}
health_potion = {"heal_min":30, "heal_max":40}

action = {1: "Attack", 2:"Heavy Attack", 3:"Drink Potion", 4:"Inspect enemy", 5:"Escape", 6: "Counterattack"}
def encounter():
    opponent = random.choice(list(enemies.keys()))
    return opponent

def attack(foe):
    attack_min = player["attack_min"]
    attack_max = player["attack_max"]
    damage = random.randint(attack_min, attack_max)
    c = random.randint(1,10)
    if c == 10:
        print("Critical strike!")
        time.sleep(3)
        damage *=2
    enemies[foe]["hp"] -= damage
    if enemies[foe]["hp"] <= 0:
        enemies[foe]["hp"] = 0
    print("You inflicted ", damage, "damage!")
    time.sleep(3)
    print(foe, "has", enemies[foe]["hp"], "Hp remaining")
    time.sleep(3)

def heavy_attack(foe):
    heavy_min = player["heavy_min"]
    heavy_max = player["heavy_max"]
    damage = random.randint(heavy_min, heavy_max)
    roll = random.randint(1, 100)
    if roll <= 75:
        print("Hit!")
        time.sleep(1)
        c = random.randint(1,10)
        if c == 10:
            print("Critical strike!")
            time.sleep(3)
            damage *=2
        enemies[foe]["hp"] -= damage
        print("You inflict ", damage, "damage!")
        time.sleep(3)
    else:
        print("Miss!")
    if enemies[foe]["hp"] <= 0:
            enemies[foe]["hp"] = 0
    print(foe, "has", enemies[foe]["hp"], "HP remaining")
    time.sleep(3)

def enAttack(foe):
    attack_min = enemies[foe]["attack_min"]
    attack_max = enemies[foe]["attack_max"]
    damage = random.randint(attack_min, attack_max)
    print("The ", foe, "inflicts ", damage, "damage!")
    time.sleep(3)
    player["hp"] -= damage
    if player["hp"] <= 0:
        player["hp"] = 0
    print("You have ", player["hp"], "HP left.")
    time.sleep(3)

def counterattack(foe):
    r = random.randint(1, 2)
    if r == 1:
        print("You fail...")
        time.sleep(3)
        enAttack(foe)
    elif r == 2:
        print("The enemy misses!")
        damage = random.randint(player["attack_min"], player["attack_max"])*3
        enemies[foe]["hp"] -= damage
        print("You inflict ", damage, "damage!")
        time.sleep(3)
        if enemies[foe]["hp"]<= 0:
            enemies[foe]["hp"] = 0
        print(foe, "has", enemies[foe]["hp"], "HP remaining.")
        


def heal():
    heal_min = health_potion["heal_min"]
    heal_max = health_potion["heal_max"]
    healing = random.randint(heal_min, heal_max)
    if player["hp"] == player["max_hp"]:
        print("Already at max HP!")
        time.sleep(3)
        return False    
    elif player["potions"] >= 1:
        player["hp"] += healing
        player["potions"] -= 1
        print("The potion heals you for ", healing, "HP!")
        time.sleep(3)
        if player["hp"] > player["max_hp"]:
            player["hp"] = player["max_hp"]
            print("You are at max HP!")
        print("You have ", player["hp"], "HP and ", player["potions"], " potions left.")
        time.sleep(3)
        return True
    else:
        print("No potions remaining!")
        time.sleep(3)
        return False
    
def inspect(foe):
    print(foe, enemies[foe]["hp"])
    time.sleep(3)

def reset_enemy(foe):
    enemies[foe]["hp"] = enemies[foe]["max_hp"]

def full_reset(foe):
    reset_enemy(foe)
    player["hp"] = player["max_hp"]
    player["potions"] = 3
    return True

def loot(n, x, y):
    for number in range(n):
        print("Searching", end="")
        time.sleep(1)
        print("\rSearching.", end="")
        time.sleep(1)
        print("\rSearching..", end="")
        time.sleep(1)
        print("\rSearching...", end="")
        time.sleep(1)
        flChance = 80 - player["hp"]
        if flChance <= 0:
            flChance = 0
        flLoot = random.randint(1,100)
        if flChance >= flLoot:
            print("You find a potion!")
            player["potions"] += 1
            time.sleep(3)
        else:
            print("You find nothing...")
            time.sleep(3)
        print(player["potions"])
        time.sleep(3)
    if (x==10 or x==20 or x==30 or x==40 or x==50) and y==True:
        print("You earned three potions!")
        player["potions"] += 3
        

def rest(heal_min, heal_max):
    healing = random.randint(heal_min, heal_max)
    player["hp"] += healing
    print("You rest for a bit...")
    time.sleep(3)
    print("You recover ", healing, "HP!")
    if player["hp"] >= player["max_hp"]:
        print("You are at max HP!")
        player["hp"] = player["max_hp"]
    time.sleep(3)

def escape(s, foe):
    print("You escape from the ", foe, "!")
    if s > 0:
        s -= 1
    rest(10, 20)
    y = False
    loot(1, 0, y)

    reset_enemy(foe)
    return s



exit = False
mercy = True
counter = 0
checkpoint = True

while True:
    foe = encounter()
    ongoing = True
    if exit == True:
        break
    print("Current score: ", score)
    if score >= 5:
        mercy = False
    if score==10 or score==20 or score==30 or score==40 or score==50:
        counter += 1
        if counter >= 6:
            checkpoint = False

    if score >= 50:
        print("You are filled with determination...")
        time.sleep(2)
    if mercy == True:
        print("The dungeon has mercy on you...")
        time.sleep(2)
        print("You heal 10HP!")
        player["hp"] += 10
        if player["hp"]>=player["max_hp"]:
            player["hp"] = player["max_hp"]
            print("You are at max HP!")

    print("A ", foe, "appears!")
    while ongoing == True:
        print("What do you want to do?\n", action)
        strAct = input()
        try:
            intAct = int(strAct)
        except ValueError:
            print("Invalid input...")
            time.sleep(3)
            continue
        if intAct not in action:
            print("Invalid input...")
            time.sleep(3)
            continue
        else:
            if intAct == 1:
                attack(foe)
            elif intAct == 2:
                heavy_attack(foe)
            elif intAct == 3:
                healed = heal()
                if healed == False:
                    continue
            elif intAct == 4:
                inspect(foe)
                continue
            elif intAct == 5:
                if score == 0:
                    print("You have nothing left to sacrifice, nothing left to lose. Fight until the dungeon claims you.")
                elif player["hp"] <=50:
                    print("You are too weak to escape.")
                    continue
                elif score >= 50:
                    print("You are emboldened by your victories. You cannot turn back now.")
                else:
                    score = escape(score, foe)
                    ongoing = False
                    continue
            elif intAct == 6:
                counterattack(foe)
        if enemies[foe]["hp"] == 0:
                    print("You win!")
                    reset_enemy(foe)
                    score += 1
                    loot(2, score, checkpoint)
                    rest(10, 40)
                    print("Current score: ", score)
                    print("Advancing in the dungeon...")
                    time.sleep(3)
                    ongoing = False
                    continue
        print("The enemy attacks!")
        time.sleep(3)
        enAttack(foe)
        if player["hp"] == 0:
            print("Game over!")
            time.sleep(3)
            print("Final score: ", score)
            time.sleep(3)
            mercy = full_reset(foe)
            score = 0
            while True:
                over = input("Try again?\nY/N\n")
                if over.lower() == "y":
                    ongoing = False
                    break
                elif over.lower()=="n":
                    print("Thank you for playing!")
                    time.sleep(3)
                    ongoing = False
                    exit = True
                    break
                else:
                    print("Invalid input")
